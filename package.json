{
  "name": "smartmed-local-mvp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite --host 0.0.0.0 --port 4173",
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "functions:build": "npm --prefix functions run build",
    "functions:test": "npm run functions:build && node --test functions/lib/doseTime.test.js"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "dependencies": {
    "firebase": "^13.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
