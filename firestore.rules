rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      match /medications/{documentId} { allow read, write: if isOwner(userId); }
      match /scheduledDoses/{documentId} { allow read, write: if isOwner(userId); }
      match /settings/{documentId} { allow read, write: if isOwner(userId); }
      match /trustedContacts/{documentId} { allow read, write: if isOwner(userId); }
      match /devices/{documentId} { allow read, write: if isOwner(userId); }
      match /notificationEvents/{documentId} { allow read: if isOwner(userId); allow write: if false; }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
